#!/bin/bash
set -euo pipefail
exec > >(tee -a /var/log/minecraft-bootstrap.log | logger -t minecraft-bootstrap -s 2>/dev/console) 2>&1
dnf install -y java-21-amazon-corretto-headless python3
useradd --system --home-dir /srv/minecraft --shell /sbin/nologin minecraft
install -d -o minecraft -g minecraft /srv/minecraft
install -d /opt/minecraft
python3 <<'PY'
import hashlib, json, pathlib, urllib.request, uuid

def get(url):
    with urllib.request.urlopen(url, timeout=60) as response:
        return response.read()

manifest = json.loads(get('https://piston-meta.mojang.com/mc/game/version_manifest_v2.json'))
entry = next(item for item in manifest['versions'] if item['id'] == '${version}')
metadata = json.loads(get(entry['url']))
download = metadata['downloads']['server']
jar = get(download['url'])
if hashlib.sha1(jar).hexdigest() != download['sha1']:
    raise RuntimeError('Mojang server checksum mismatch')
pathlib.Path('/opt/minecraft/server.jar').write_bytes(jar)
names = json.loads('${whitelist}')
players = []
for name in names:
    profile = json.loads(get('https://api.mojang.com/users/profiles/minecraft/' + name))
    players.append({'uuid': str(uuid.UUID(profile['id'])), 'name': profile['name']})
pathlib.Path('/srv/minecraft/whitelist.json').write_text(json.dumps(players))
properties = '\n'.join([
    'server-port=25565', 'online-mode=true', 'enable-rcon=false',
    'enable-query=false', 'max-players=10', 'view-distance=8',
    'simulation-distance=6', 'motd=Angel - on-demand Minecraft',
    'white-list=' + str(bool(names)).lower(),
    'enforce-whitelist=' + str(bool(names)).lower(),
])
pathlib.Path('/srv/minecraft/server.properties').write_text(properties + '\n')
pathlib.Path('/srv/minecraft/eula.txt').write_text('eula=true\n')
PY
chown -R minecraft:minecraft /srv/minecraft
cat > /etc/systemd/system/minecraft.service <<'SERVICE'
[Unit]
Description=On-demand Minecraft Java server
After=network-online.target
Wants=network-online.target
[Service]
User=minecraft
Group=minecraft
WorkingDirectory=/srv/minecraft
ExecStart=/usr/bin/java -Xms1G -Xmx2G -jar /opt/minecraft/server.jar nogui
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
KillSignal=SIGINT
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/minecraft
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=3G
[Install]
WantedBy=multi-user.target
SERVICE
systemctl daemon-reload
systemctl enable --now minecraft
