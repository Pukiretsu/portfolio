#!/bin/bash
set -euo pipefail
exec > >(tee -a /var/log/minecraft-bootstrap.log | logger -t minecraft-bootstrap -s 2>/dev/console) 2>&1
export AWS_DEFAULT_REGION='${aws_region}'
echo '[Java] Preparing ARM64 Temurin 25 and provisioning tools'
[ "$(uname -m)" = aarch64 ] || { echo 'ERROR: aarch64 is required'; exit 1; }
# AL2023 ships curl-minimal; avoid conflicting with it by installing only if missing.
command -v curl >/dev/null || dnf install -y curl-minimal
dnf install -y jq tar gzip python3 awscli-2 util-linux
for tool in curl jq tar gzip python3 swapon mkswap; do
  command -v "$tool" >/dev/null || { echo "ERROR: missing $tool"; exit 1; }
done
getent passwd minecraft >/dev/null || useradd --system --home-dir /srv/minecraft --shell /sbin/nologin minecraft
install -d -o minecraft -g minecraft /srv/minecraft
install -d /opt/minecraft
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
curl --fail --silent --show-error --location --retry 3 \
  'https://api.adoptium.net/v3/assets/latest/25/hotspot?architecture=aarch64&image_type=jdk&os=linux&vendor=eclipse' > "$work/java.json"
jq -e 'length > 0' "$work/java.json" >/dev/null
java_url=$(jq -er '.[0].binary.package.link | select(startswith("https://"))' "$work/java.json")
java_sha=$(jq -er '.[0].binary.package.checksum' "$work/java.json")
java_release=$(jq -er '.[0].release_name | select(test("^[a-zA-Z0-9+._-]+$"))' "$work/java.json")
java_home="/opt/minecraft/temurin-$java_release"
if [ ! -x "$java_home/bin/java" ]; then
  curl --fail --silent --show-error --location --retry 3 "$java_url" -o "$work/java.tar.gz"
  echo "$java_sha  $work/java.tar.gz" | sha256sum --check -
  mkdir "$work/jdk"
  tar -xzf "$work/java.tar.gz" --strip-components=1 -C "$work/jdk"
  "$work/jdk/bin/java" -version
  mv "$work/jdk" "$java_home"
fi
ln -sfn "$java_home" /opt/minecraft/java
/opt/minecraft/java/bin/java -XshowSettings:properties -version 2>&1 | tee "$work/java-settings"
grep -Eq 'java.specification.version = 25$' "$work/java-settings"
grep -Eq 'os.arch = aarch64$' "$work/java-settings"

echo '[Swap] Ensuring a 2G fallback with swappiness=10'
if [ -z "$(swapon --show --noheadings)" ]; then
  if [ ! -f /swapfile ]; then
    # dd allocates physical blocks on AL2023 XFS (sparse files cannot be used as swap).
    dd if=/dev/zero of=/swapfile bs=1M count=2048 status=none
    chmod 600 /swapfile
    mkswap /swapfile
  fi
  chmod 600 /swapfile
  swapon /swapfile
  grep -qE '^/swapfile[[:space:]]' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi
echo 'vm.swappiness=10' > /etc/sysctl.d/90-minecraft-swap.conf
sysctl -p /etc/sysctl.d/90-minecraft-swap.conf

# Stop Java before updating managed JARs. Terraform remains the only resource destroyer.
if systemctl cat minecraft.service >/dev/null 2>&1; then
  systemctl stop minecraft.service
fi
# Compression keeps the complete EC2 user-data below its 16 KiB limit.
echo '${installer_gzip}' | base64 --decode | gzip --decompress > /opt/minecraft/install-server.py
install -d /opt/minecraft-bootstrap
for name in server_config.py world.py minecraft-bootstrap.py; do
  aws s3 cp 's3://${backup_bucket}/bootstrap/'"$name" /opt/minecraft-bootstrap/"$name" --only-show-errors
done
aws s3 cp 's3://${backup_bucket}/${launch_config_key}' /opt/minecraft-bootstrap/launch.json --only-show-errors
export MINECRAFT_CONFIG_FILE=/opt/minecraft-bootstrap/launch.json
python3 /opt/minecraft/install-server.py '${version}' '${fabric_loader_version}' '${fabric_installer_version}' '${fabric_api_version}'
python3 /opt/minecraft-bootstrap/minecraft-bootstrap.py /opt/minecraft-bootstrap/launch.json '${backup_bucket}'
chown -R minecraft:minecraft /srv/minecraft
cat > /etc/systemd/system/minecraft.service <<'SERVICE'
[Unit]
Description=On-demand Fabric Minecraft server
After=network-online.target
Wants=network-online.target
[Service]
User=minecraft
Group=minecraft
WorkingDirectory=/srv/minecraft
ExecStart=/opt/minecraft/java/bin/java -Xms2800M -Xmx2800M -XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=100 -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC -XX:+AlwaysPreTouch -XX:G1NewSizePercent=30 -XX:G1MaxNewSizePercent=40 -XX:G1HeapRegionSize=8M -XX:G1ReservePercent=20 -XX:InitiatingHeapOccupancyPercent=15 -jar /srv/minecraft/fabric-server-launch.jar nogui
Restart=on-failure
RestartSec=10
TimeoutStopSec=120
KillSignal=SIGINT
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/minecraft
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Allow native/off-heap overhead above the 2800M heap; retain OS headroom.
MemoryHigh=3400M
MemoryMax=3584M
MemorySwapMax=2G
[Install]
WantedBy=multi-user.target
SERVICE
systemctl daemon-reload
systemctl enable minecraft
systemctl restart minecraft

# Root-owned monitor code cannot be replaced by the unprivileged game process.
install -d /opt/minecraft-monitor
echo '${monitor_gzip}' | base64 --decode | gzip --decompress > /opt/minecraft-monitor/activity_monitor.py
echo '${activity_gzip}' | base64 --decode | gzip --decompress > /opt/minecraft-monitor/activity.py
echo '${protocol_gzip}' | base64 --decode | gzip --decompress > /opt/minecraft-monitor/protocol.py
cat > /etc/systemd/system/minecraft-activity.service <<'MONITOR_SERVICE'
[Unit]
Description=Minecraft activity tracking and graceful idle stop
After=network-online.target minecraft.service
Wants=network-online.target
[Service]
ExecStart=/usr/bin/python3 /opt/minecraft-monitor/activity_monitor.py
Environment=AWS_DEFAULT_REGION=${aws_region}
StateDirectory=minecraft-monitor
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
[Install]
WantedBy=multi-user.target
MONITOR_SERVICE
systemctl daemon-reload
systemctl enable --now minecraft-activity
